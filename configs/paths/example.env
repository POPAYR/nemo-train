# 实验机路径配置模板。复制为 configs/paths/<机器名>.env(已被 .gitignore,不会提交),改成实际路径。
# remote/*.sh 会自动 source configs/paths/$XN_HOST.env(默认 XN_HOST=$(hostname -s))。
# 未设置的变量回落到开发机路径(见 src/utils/paths.py),在实验机上一律必须设置。
export XN_REPO=/path/to/x-nemo-inference                     # 本仓库 clone 位置
export XN_PRETRAINED=/path/to/pretrained                     # sd-image-variations-diffusers / stable-video-diffusion-img2vid / xnemo_ckpt / umt5-base ...
export XN_HALLO3_RAW=/path/to/hallo3_raw                       # 原始 mp4(搬来的)
export XN_HALLO3=/path/to/hallo3                               # 定稿清单 + caption(搬来的);remote/prepare_data.sh 在这里生成帧/latent/音频
export XN_MEAD=/path/to/mead_fixed                           # 可选
export XN_TESTSET=/path/to/eval_metrics/testset              # manifest.json / hallo3_subset30.json
export XN_HALLO3_TEST=/path/to/hallo3_test                   # 可选
export XN_FVD_I3D=/path/to/i3d_torchscript.pt                # FVD 用 I3D 权重(49MB)
export XN_OUTPUT=$XN_REPO/output                             # 训练/评测产物
export XN_MOTAR_STATS=$XN_REPO/third_party/motar/global_motion_latent_stats.pt
# Python 环境(conda 或 venv 的 python 路径)
export XN_PY=/path/to/envs/xnemo/bin/python
export XN_FACE_PY=/path/to/envs/face/bin/python             # 必需:抽帧与盲测用(insightface)
